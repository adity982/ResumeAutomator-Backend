APP_ENV=development
AUTH_MODE=development
DATABASE_URL=sqlite:///./resume_app.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FIREBASE_PROJECT_ID=
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
MAX_UPLOAD_BYTES=5242880
MAX_PDF_PAGES=20
RATE_LIMIT_PER_MINUTE=120
SCRAPE_CACHE_SIZE=128
SCRAPE_CACHE_TTL_SECONDS=600
AI_TIMEOUT_SECONDS=30
LOG_LEVEL=INFO
DOCS_ENABLED=true
EMBEDDING_PROVIDER=lexical
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
MODEL_CACHE_DIR=.cache/models
WORKER_LEASE_SECONDS=300
# Optional server-side token for public repository API rate limits. This token does not grant private-import access.
GITHUB_PUBLIC_TOKEN=
# Required only for compose.yaml. Set a strong URL-safe value before starting Docker Compose.
POSTGRES_PASSWORD=
# Optional selected-repository GitHub App connection. Credentials are server-side only.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_SLUG=
GITHUB_REDIRECT_URI=
CONNECTION_ENCRYPTION_KEY=
